        "https://TROCAR-PELO-DOMINIO-DO-AQR/entrar",
        "https://TROCAR-PELO-DOMINIO-DO-AQR/"
      ],
      "webOrigins": [
        "https://TROCAR-PELO-DOMINIO-DO-AQR"
      ],
      "attributes": {
        "post.logout.redirect.uris": "https://TROCAR-PELO-DOMINIO-DO-AQR/entrar"
      },
      "clientAuthenticatorType": "client-secret",
      "baseUrl": "https://TROCAR-PELO-DOMINIO-DO-AQR/entrar"
    },
    {
      "clientId": "aqr-admin",
      "name": "AQR (servidor)",
      "enabled": true,
      "publicClient": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true
    }
