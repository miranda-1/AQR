# Login real em desenvolvimento: Keycloak escondido (docker/dev/compose.yml) + e-mails pelo Mailpit.
# SÓ DESENVOLVIMENTO: segredos de teste, HTTP e SMTP sem TLS (o servidor recusa tudo isso em produção).
# Usado por `npm run dev:login` e pelos comandos `npm run login:*`.
AUTH_MODE=keycloak
KEYCLOAK_ISSUER=http://localhost:8080/realms/aqr
KEYCLOAK_CLIENT_ID=aqr-web
KEYCLOAK_CLIENT_SECRET=aqr-web-dev-secret
KEYCLOAK_ADMIN_CLIENT_ID=aqr-admin
KEYCLOAK_ADMIN_CLIENT_SECRET=aqr-admin-dev-secret
APP_BASE_URL=http://localhost:5173
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURITY=nenhuma
SMTP_FROM="AQR <nao-responda@aqr.local>"
DATABASE_PATH=data/aqr-login.sqlite
