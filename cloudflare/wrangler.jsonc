{
  // Hospedagem do AQR na Cloudflare (Workers + Containers). Guia: docs/hospedagem-cloudflare.md
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "aqr",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },

  // Site: os arquivos de `npm run build`. Endereços como /comparacao devolvem o index.html (SPA).
  // Só /api/* passa pelo Worker (e segue para o contêiner).
  "assets": {
    "directory": "../dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  // Servidor de comparação: imagem do Dockerfile da raiz, uma instância.
  "containers": [
    {
      "class_name": "AqrComparador",
      "image": "../Dockerfile",
      "image_build_context": "..",
      "instance_type": "standard-1",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "AQR_COMPARADOR", "class_name": "AqrComparador" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["AqrComparador"] }]
}
