# Exemplo de configuração, com os valores padrão. Mude só o que precisar.
# O site (Vite) lê as variáveis VITE_* de um arquivo .env; o servidor lê do ambiente,
# por exemplo: PORT=3001 npm run dev:server

# --- Site (Vite) ---
# "api" (padrão): comparação real no servidor. "demo": dados fictícios, sem servidor.
VITE_COMPARISON_SERVICE=api

# --- Servidor (npm run dev:server / start:server) ---
NODE_ENV=development
# Só a máquina local. Não exponha na rede enquanto não houver autenticação real.
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
# Comparações ao mesmo tempo, fila de espera, tempo máximo, prazo do resultado não buscado (depois de
# entregue, ele é descartado em seguida) e memória por comparação.
COMPARISON_WORKERS=2
COMPARISON_QUEUE_LIMIT=8
COMPARISON_TIMEOUT_MS=120000
COMPARISON_RESULT_TTL_MS=300000
COMPARISON_WORKER_MEMORY_MB=768
# Banco SQLite das contas e da auditoria (a pasta é criada se não existir).
DATABASE_PATH=data/aqr.sqlite
# Administração de contas: "disabled" (padrão) ou "dev" (sem autenticação real; só com
# NODE_ENV diferente de production e HOST=127.0.0.1 — o servidor recusa iniciar se não for assim).
ADMIN_API_MODE=disabled

# Login real (ver docs/login-keycloak.md). Inícios de login e retornos do Keycloak aceitos por IP, por minuto.
AUTH_LOGIN_ATTEMPTS_PER_MINUTE=30
# IPs ou faixas CIDR do proxy reverso (separados por vírgula), para registrar o IP real de quem acessa.
# Vazio: nenhum proxy confiável.
TRUST_PROXY=
