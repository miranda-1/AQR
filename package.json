{
  "name": "aqr",
  "private": true,
  "version": "0.0.0",
  "description": "AQR — Análise e Qualificação de Requerimentos (SEMADES · Prefeitura de Campo Grande). Protótipo de frontend.",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite",
    "dev:server": "tsx watch server/main.ts",
    "build": "tsc -b && vite build && npm run build:server",
    "build:server": "tsc -p tsconfig.server.build.json",
    "start:server": "node dist-server/server/main.js",
    "db:migrar": "tsx server/db/cli-migrar.ts",
    "admin:criar": "tsx server/scripts/criar-admin.ts",
    "admin:vincular": "tsx server/scripts/vincular-identidade.ts",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:corpus": "vitest run --project corpus",
    "avaliar:corpus": "tsx server/comparison/evaluation/report-cli.ts"
  },
  "dependencies": {
    "@fastify/multipart": "^10.1.3",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@napi-rs/canvas": "1.0.10",
    "@tesseract.js-data/por": "1.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "diff": "^9.0.0",
    "fastify": "^5.12.5",
    "lucide-react": "^1.53.0",
    "openid-client": "^6.8.8",
    "pdfjs-dist": "^6.4.299",
    "radix-ui": "^1.7.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "tailwind-merge": "^3.7.0",
    "tesseract.js": "7.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@pdf-lib/fontkit": "1.1.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "axe-core": "^4.14.0",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "pdf-lib": "^1.17.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
